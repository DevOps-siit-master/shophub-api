# Copy to .env for local development.

NODE_ENV=development
PORT=3001

# MUST match JWT_ACCESS_SECRET of shophub-auth-service so its access tokens are
# accepted here.
JWT_ACCESS_SECRET=change-me-to-match-auth-service

# Namespace the Shop/Wallet/DiscordChannel CRs are created in. The shop-operator
# must be watching this namespace.
SHOP_NAMESPACE=shophub-shops

# Optional: explicit kubeconfig path for local dev. When unset the client uses
# in-cluster config (in a pod) or the default kubeconfig (~/.kube/config).
# KUBECONFIG=/home/you/.kube/config

# Template for a deployed shop's public URL; {name} is the Shop CR name.
SHOP_URL_TEMPLATE=http://{name}.localhost

# Optional CORS origin (only needed if the frontend is not proxied same-origin).
# CORS_ORIGIN=http://localhost:5173
